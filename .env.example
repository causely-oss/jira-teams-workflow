# Keep comments on their own lines: `kubectl create secret --from-env-file` and
# `docker --env-file` treat a trailing "# ..." as part of the value.

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Causely MCP. Create an API client (id + secret) in the Causely portal.
# Client id and secret are exchanged for a short-lived JWT, then sent as Bearer.
# The MCP URL, token URL, and portal URL must all point at the same Causely environment.
CAUSELY_MCP_URL=https://api.causely.app/mcp
CAUSELY_CLIENT_ID=
CAUSELY_CLIENT_SECRET=
CAUSELY_TOKEN_URL=https://auth.causely.app/frontegg/identity/resources/auth/v2/api-token
CAUSELY_PORTAL_URL=https://portal.causely.app

# true = no Jira writes: tickets are written to ./dry-run/ instead. Jira credentials optional.
JIRA_DRY_RUN=false

# Atlassian. Used by the Rovo MCP backend (default) and by the REST backend.
# Rovo MCP headless auth must be enabled by an org admin:
#   admin.atlassian.com > Rovo MCP server > Authentication > API token
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
# Must be a SCOPED API token: id.atlassian.com > Security > API tokens >
# "Create API token with scopes" > Jira. Select:
#   read:jira-work, write:jira-work                            (tickets, via Jira REST)
#   read:jira:agent-interface, search:jira:agent-interface    (Rovo duplicate check)
#   write:jira:agent-interface                                 (only for jira.backend: rovo)
# A classic token works for tickets, but Rovo MCP rejects it.
JIRA_API_TOKEN=
# Optional: service account API key (Bearer), preferred for a bot
ATLASSIAN_SERVICE_KEY=
# Optional: looked up from JIRA_BASE_URL (/_edge/tenant_info) when empty
ATLASSIAN_CLOUD_ID=
ROVO_MCP_URL=https://mcp.atlassian.com/v2/mcp

# Microsoft Teams: Workflows template "Send webhook alerts to a channel"
TEAMS_WORKFLOW_URL=

# Shared secret checked on every inbound webhook (?token=... or X-Webhook-Token header)
INBOUND_WEBHOOK_TOKEN=

STATE_DB=./state.db
ROUTING_CONFIG=./config.yaml
